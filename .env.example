# OpenAI or OpenRouter (same API)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
# For OpenRouter: https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o

# amoCRM private integration
# Create at: amoCRM → Settings → Integrations → Private integrations
AMO_CLIENT_ID=your-integration-client-id
AMO_CLIENT_SECRET=your-integration-client-secret
AMO_REDIRECT_URI=https://example.com

# Pipeline settings (EliteDent defaults)
AMO_PIPELINE_ID=8166506

# Server port
PORT=8003
